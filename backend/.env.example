# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Supports both MONGO_URI and MONGODB_URI)
# Local MongoDB: mongodb://127.0.0.1:27017/mentorbridge
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mentorbridge?retryWrites=true&w=majority
# NOTE: In MongoDB Atlas, whitelist 0.0.0.0/0 in Network Access for cloud hosts (e.g. Render).
# NOTE: Free Atlas M0 clusters pause after 30 days of inactivity. Click "Resume" in Atlas dashboard if paused.
MONGO_URI=mongodb://127.0.0.1:27017/mentorbridge

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Client Configuration
CLIENT_URL=http://localhost:5000

# File Upload Configuration
UPLOADS_PATH=uploads/
